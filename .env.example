# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in whatever keys you have.
# The app runs end-to-end with NO keys at all (local extractor + mock company
# provider + logged/simulated email), so a key is optional, not required.
# ---------------------------------------------------------------------------

PORT=4000

# --- AI extraction (document -> structured fields) --------------------------
# Free key: https://aistudio.google.com/apikey  (Google AI Studio, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional free LLM fallback for the PDF *text* layer (no vision on the free
# tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# --- Company verification ---------------------------------------------------
# Provider chain (auto = first configured wins):
#   opencorporates -> companies_house -> gleif (no key required)
# OpenCorporates: https://opencorporates.com/api (evaluation access)
# Companies House: https://developer.company-information.service.gov.uk (free key)
# GLEIF:           https://api.gleif.org/api/v1/lei-records (official, keyless)
VERIFY_PROVIDER=auto
OPENCORPORATES_API_KEY=
COMPANIES_HOUSE_API_KEY=
# Optional jurisdiction filter for OpenCorporates, e.g. in, gb, us. Leave blank to search globally.
OC_JURISDICTION=

# --- Email ------------------------------------------------------------------
# auto = Resend if key present -> SMTP if configured -> log (simulated) fallback
EMAIL_PROVIDER=auto
RESEND_API_KEY=
EMAIL_FROM="Vendor Verification <onboarding@resend.dev>"

# SMTP (any provider; Gmail needs an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Storage ----------------------------------------------------------------
DB_PATH=data/app.db
UPLOAD_DIR=data/uploads
